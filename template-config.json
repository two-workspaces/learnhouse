{
 "services": {
  "040fd6d5-be9a-4ff6-a40c-83dec363117e": {
   "icon": "https://raw.githubusercontent.com/two-workspaces/learnhouse/main/icon.png",
   "name": "LearnHouse",
   "deploy": {
    "startCommand": null,
    "healthcheckPath": "/api/v1/health",
    "restartPolicyType": "ON_FAILURE",
    "restartPolicyMaxRetries": 10
   },
   "source": {
    "repo": "https://github.com/two-workspaces/learnhouse",
    "rootDirectory": null
   },
   "variables": {
    "PORT": {
     "defaultValue": "80",
     "description": "Port LearnHouse serves on; the Railway domain points here. Leave it at 80.",
     "isOptional": false
    },
    "LEARNHOUSE_INITIAL_ADMIN_EMAIL": {
     "defaultValue": "admin@example.com",
     "description": "Email of the first admin, created on the first boot. Change it to yours before deploying.",
     "isOptional": false
    },
    "LEARNHOUSE_INITIAL_ADMIN_PASSWORD": {
     "defaultValue": "${{secret(20, \"abcdefghijklmnopqrstuvwxyzABCDEFGHIJKLMNOPQRSTUVWXYZ0123456789\")}}",
     "description": "Generated password for the first admin; copy it from here to sign in, then change it in LearnHouse.",
     "isOptional": false
    },
    "LEARNHOUSE_INITIAL_ORG_NAME": {
     "defaultValue": "My Academy",
     "description": "Name of your school or organization, set on the first boot; rename it later in the dashboard.",
     "isOptional": false
    },
    "LEARNHOUSE_INITIAL_ORG_SLUG": {
     "defaultValue": "default",
     "description": "Short id of the organization used in its URLs, set on the first boot. Leave it as is unless you know you need another.",
     "isOptional": false
    },
    "LEARNHOUSE_DOMAIN": {
     "defaultValue": "${{RAILWAY_PUBLIC_DOMAIN}}",
     "description": "Host name people open LearnHouse at. Set it to your custom domain (learn.example.com) when you add one; every URL follows it.",
     "isOptional": false
    },
    "LEARNHOUSE_AUTH_JWT_SECRET_KEY": {
     "defaultValue": "${{secret(48, \"abcdefghijklmnopqrstuvwxyzABCDEFGHIJKLMNOPQRSTUVWXYZ0123456789\")}}",
     "description": "Signs sign-in tokens. Generated; keep it secret.",
     "isOptional": false
    },
    "NEXTAUTH_SECRET": {
     "defaultValue": "${{secret(48, \"abcdefghijklmnopqrstuvwxyzABCDEFGHIJKLMNOPQRSTUVWXYZ0123456789\")}}",
     "description": "Encrypts web sessions. Generated; keep it secret.",
     "isOptional": false
    },
    "COLLAB_INTERNAL_KEY": {
     "defaultValue": "${{secret(48, \"abcdefghijklmnopqrstuvwxyzABCDEFGHIJKLMNOPQRSTUVWXYZ0123456789\")}}",
     "description": "Shared key between the API and the live collaboration server. Generated; keep it secret.",
     "isOptional": false
    },
    "LEARNHOUSE_SQL_CONNECTION_STRING": {
     "defaultValue": "postgresql://${{Postgres.POSTGRES_USER}}:${{Postgres.POSTGRES_PASSWORD}}@${{Postgres.RAILWAY_PRIVATE_DOMAIN}}:5432/${{Postgres.POSTGRES_DB}}",
     "description": "Postgres over the private network; leave as is.",
     "isOptional": false
    },
    "LEARNHOUSE_REDIS_CONNECTION_STRING": {
     "defaultValue": "redis://default:${{Redis.REDIS_PASSWORD}}@${{Redis.RAILWAY_PRIVATE_DOMAIN}}:6379/0",
     "description": "Redis for the API, over the private network; leave as is.",
     "isOptional": false
    },
    "LEARNHOUSE_REDIS_URL": {
     "defaultValue": "redis://default:${{Redis.REDIS_PASSWORD}}@${{Redis.RAILWAY_PRIVATE_DOMAIN}}:6379/0?family=0",
     "description": "Redis for the collaboration server, over the private network; leave as is.",
     "isOptional": false
    }
   },
   "networking": {
    "serviceDomains": {
     "<hasDomain>:80": {
      "port": 80
     }
    },
    "tcpProxies": {}
   },
   "volumeMounts": {
    "040fd6d5-be9a-4ff6-a40c-83dec363117e": {
     "mountPath": "/data"
    }
   }
  },
  "56f38ffd-692d-48ca-a725-0e064268f102": {
   "icon": "https://devicons.railway.app/i/postgresql.svg",
   "name": "Postgres",
   "deploy": {
    "startCommand": null,
    "healthcheckPath": null,
    "restartPolicyType": "ON_FAILURE",
    "restartPolicyMaxRetries": 10
   },
   "source": {
    "image": "pgvector/pgvector:0.8.7-pg16"
   },
   "variables": {
    "POSTGRES_DB": {
     "defaultValue": "learnhouse",
     "description": "Database name",
     "isOptional": false
    },
    "POSTGRES_USER": {
     "defaultValue": "learnhouse",
     "description": "Database user",
     "isOptional": false
    },
    "POSTGRES_PASSWORD": {
     "defaultValue": "${{secret(32, \"abcdefghijklmnopqrstuvwxyzABCDEFGHIJKLMNOPQRSTUVWXYZ0123456789\")}}",
     "description": "Generated database password",
     "isOptional": false
    },
    "PGDATA": {
     "defaultValue": "/var/lib/postgresql/data/pgdata",
     "description": "Data subdirectory, which keeps Postgres happy on Railway volumes",
     "isOptional": false
    },
    "RAILWAY_DEPLOYMENT_DRAINING_SECONDS": {
     "defaultValue": "60",
     "description": "Time for Postgres to shut down cleanly on redeploy",
     "isOptional": false
    }
   },
   "networking": {
    "serviceDomains": {},
    "tcpProxies": {}
   },
   "volumeMounts": {
    "56f38ffd-692d-48ca-a725-0e064268f102": {
     "mountPath": "/var/lib/postgresql/data"
    }
   }
  },
  "3ff11c2c-834a-46db-a1fe-848fe08b75fa": {
   "icon": "https://devicons.railway.app/i/redis.svg",
   "name": "Redis",
   "deploy": {
    "startCommand": "/bin/sh -c \"chown -R redis:redis /data && exec docker-entrypoint.sh redis-server --requirepass $REDIS_PASSWORD --appendonly yes\"",
    "healthcheckPath": null,
    "restartPolicyType": "ON_FAILURE",
    "restartPolicyMaxRetries": 10
   },
   "source": {
    "image": "redis:8.10.3-alpine"
   },
   "variables": {
    "REDIS_PASSWORD": {
     "defaultValue": "${{secret(32, \"abcdefghijklmnopqrstuvwxyzABCDEFGHIJKLMNOPQRSTUVWXYZ0123456789\")}}",
     "description": "Generated Redis password",
     "isOptional": false
    }
   },
   "networking": {
    "serviceDomains": {},
    "tcpProxies": {}
   },
   "volumeMounts": {
    "3ff11c2c-834a-46db-a1fe-848fe08b75fa": {
     "mountPath": "/data"
    }
   }
  }
 }
}